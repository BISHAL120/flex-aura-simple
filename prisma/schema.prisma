generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  // required for classic engine
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  // critical for Vercel
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

model User {
  id            String    @id @map("_id")
  firstName     String
  lastName      String?
  phoneNumber   String?
  email         String
  emailVerified Boolean   @default(false)
  profileImage  String?
  bio           String?
  location      String?
  isBanned      Boolean   @default(false)
  role          Role[]    @default([USER])
  sessions      Session[]
  accounts      Account[]
  // name field required for Better auth
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  imageUrl        String
  description     String?
  icon            String?
  color           String?
  parentId        String?
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)
  featured        Boolean  @default(false)
  tags            String[] @default([])
  sortOrder       Int?     @default(0)
  metaTitle       String?
  metaDescription String?
  products        Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String           @unique
  description    String
  price          Int              @map("priceCents")
  compareAtPrice Int?             @map("compareAtPriceCents")
  image          String
  images         String[]         @default([])
  badge          String?
  isBestSeller   Boolean          @default(false) @map("isBestSeller")
  isNewArrival   Boolean          @default(false) @map("isNewArrival")
  tags           String[]         @default([])
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  isActive       Boolean          @default(true)
  isDeleted      Boolean          @default(false)
  categoryId     String?          @db.ObjectId
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([isDeleted])
}

model ProductVariant {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  price          Int      @map("priceCents")
  compareAtPrice Int?     @map("compareAtPriceCents")
  productId      String   @db.ObjectId
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model HeroSlide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  subtitle  String
  image     String
  alt       String
  ctaLabel  String
  ctaHref   String
  order     Int      @default(0) @map("sortOrder")
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDeleted])
}

enum CustomOrderStatus {
  new
  quoted
  approved
  inProduction
  completed
  declined
}

model CustomOrder {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber      String            @unique
  customerName     String
  customerEmail    String
  customerPhone    String
  country          String
  deliveryAddress  String?
  designRequirement String
  sizeOption       String
  customDimensions String?
  withBacklitLed   Boolean           @default(false)
  specialRequest   String?
  referenceImage   String?
  quotedPrice      Int?
  status           CustomOrderStatus @default(new)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([customerEmail])
  @@index([customerPhone])
  @@index([status])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  rating    Int
  date      DateTime
  title     String
  body      String
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDeleted])
  @@index([rating])
}

model Campaign {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  description String
  image       String
  badge       String
  ctaLabel    String
  /** Product ids featured on this campaign's landing page. */
  productIds  String[] @default([])
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([isDeleted])
}
